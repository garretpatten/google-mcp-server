{
  "name": "google-mcp-server",
  "author": "Garret Patten",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing Google Calendar and Google Tasks with read/write access over stdio",
  "private": true,
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-calendar",
    "google-tasks",
    "opencode"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "google-mcp-server": "dist/index.js",
    "google-mcp-auth": "dist/auth-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "auth": "tsx src/auth-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint src tests",
    "lint:prettier": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint -c .yamllint.yaml ."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garretpatten/google-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.20.1",
    "globals": "^16.0.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.7.3",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.24.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
